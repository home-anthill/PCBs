(version 1)
# Thermocouple MCP9601 - KiCad 10
# PCBWay-oriented conservative rules: 2 layers, 1 oz, routed outline.
# Project rules, not a manufacturer certification.
(rule "Copper clearance"
    (constraint clearance (min 0.15mm)))
(rule "Track width"
    (condition "A.Type == 'Track'")
    (constraint track_width (min 0.20mm)))
(rule "Mechanical hole range"
    (constraint hole_size (min 0.20mm) (max 6.30mm)))
(rule "Standard through vias"
    (condition "A.Type == 'Via'")
    (constraint hole_size (min 0.30mm))
    (constraint via_diameter (min 0.60mm))
    (constraint annular_width (min 0.15mm))
    (constraint disallow micro_via blind_via buried_via))
(rule "PTH pads"
    (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
    (constraint hole_size (min 0.50mm) (max 6.30mm))
    (constraint annular_width (min 0.25mm)))
(rule "NPTH pads"
    (condition "A.Type == 'Pad' && A.Pad_Type == 'NPTH, mechanical'")
    (constraint hole_size (min 0.50mm)))
(rule "Plated slots"
    (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && A.Hole_Size_X != A.Hole_Size_Y")
    (constraint hole_size (min 0.50mm)))
(rule "Non-plated slots"
    (condition "A.Type == 'Pad' && A.Pad_Type == 'NPTH, mechanical' && A.Hole_Size_X != A.Hole_Size_Y")
    (constraint hole_size (min 0.80mm)))
(rule "Hole-to-hole spacing"
    (constraint hole_to_hole (min 0.50mm)))
(rule "Same-net via hole spacing"
    (condition "A.Type == 'Via' && B.Type == 'Via' && A.Net == B.Net")
    (constraint hole_to_hole (min 0.254mm)))
(rule "Hole-to-copper spacing"
    (constraint hole_clearance (min 0.33mm)))
(rule "Via-to-track hole spacing"
    (condition "A.Type == 'Via' && B.Type == 'Track'")
    (constraint hole_clearance (min 0.254mm)))
(rule "NPTH-to-track spacing"
    (condition "A.Type == 'Pad' && A.Pad_Type == 'NPTH, mechanical' && B.Type == 'Track'")
    (constraint hole_clearance (min 0.254mm)))
(rule "NPTH-to-other-copper spacing"
    (condition "A.Type == 'Pad' && A.Pad_Type == 'NPTH, mechanical' && B.Type != 'Track'")
    (constraint hole_clearance (min 0.20mm)))
(rule "PTH-to-track copper spacing"
    (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && B.Type == 'Track'")
    (constraint clearance (min 0.20mm)))
# Preserve the existing project margin for pads, vias and zones.
(rule "Copper-to-routed-edge spacing"
    (constraint edge_clearance (min 0.50mm)))
# PCBWay template allowance for tracks only.
(rule "Track-to-routed-edge spacing"
    (condition "A.Type == 'Track'")
    (constraint edge_clearance (min 0.30mm)))
(rule "Silkscreen text"
    (layer "?.Silkscreen")
    (constraint text_thickness (min 0.15mm))
    (constraint text_height (min 0.80mm)))
# Set minimum silkscreen clearance to 0.15 mm in Board Setup > Constraints.
# Do not apply a global silk_clearance rule to unrelated layers/objects.
