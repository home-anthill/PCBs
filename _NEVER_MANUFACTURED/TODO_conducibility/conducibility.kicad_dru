(version 1)

# Regole DRC per KiCad 10
# Progetto ESP32-S3, PCB a 4 strati, rame 1 oz
# Produzione standard PCBWay senza microvia, via cieche o sepolte

# =========================================================
# PRODUZIONE PCBWAY - RAME E PISTE
# =========================================================

(rule "Minimum trace width and spacing - outer layers"
    (layer outer)
    (condition "A.Type == 'Track'")
    (constraint track_width (min 0.15mm))
    (constraint clearance (min 0.15mm))
)

(rule "Minimum trace width and spacing - inner layers"
    (layer inner)
    (condition "A.Type == 'Track'")
    (constraint track_width (min 0.15mm))
    (constraint clearance (min 0.15mm))
)

# =========================================================
# FORI, VIA E PAD
# =========================================================

(rule "Mechanical drill range"
    (constraint hole_size (min 0.15mm) (max 6.3mm))
)

(rule "Standard through-via dimensions"
    (condition "A.Type == 'Via'")
    (constraint hole_size (min 0.30mm))
    (constraint via_diameter (min 0.60mm))
    (constraint annular_width (min 0.15mm))
    (constraint disallow micro_via blind_via buried_via)
)

(rule "PTH hole size"
    (condition "A.Type == 'Pad' && A.isPlated()")
    (constraint hole_size (min 0.20mm) (max 6.35mm))
)

(rule "Minimum non-plated hole size"
    (condition "A.Type == 'Pad' && !A.isPlated()")
    (constraint hole_size (min 0.50mm))
)

# Manteniamo 0,25 mm come regola prudente generale per i pad PTH.
(rule "PTH pad annular ring"
    (condition "A.Type == 'Pad' && A.isPlated()")
    (constraint annular_width (min 0.25mm))
)

(rule "Minimum castellated hole size"
    (condition "A.Type == 'Pad' && A.Fabrication_Property == 'Castellated pad'")
    (constraint hole_size (min 0.60mm))
)

(rule "Minimum plated slot width"
    (condition "A.Type == 'Pad' && A.isPlated() && A.Hole_Size_X != A.Hole_Size_Y")
    (constraint hole_size (min 0.50mm))
)

(rule "Minimum non-plated slot width"
    (condition "A.Type == 'Pad' && !A.isPlated() && A.Hole_Size_X != A.Hole_Size_Y")
    (constraint hole_size (min 0.80mm))
)

# =========================================================
# CLEARANCE DI FORI E RAME
# =========================================================

(rule "Hole-to-hole clearance on different nets"
    (condition "A.Net != B.Net")
    (constraint hole_to_hole (min 0.50mm))
)

(rule "Via-to-track hole clearance"
    (condition "A.Type == 'Via' && B.Type == 'Track'")
    (constraint hole_clearance (min 0.254mm))
)

(rule "Via-to-via clearance on same net"
    (condition "A.Type == 'Via' && B.Type == 'Via' && A.Net == B.Net")
    (constraint hole_to_hole (min 0.254mm))
)

(rule "PTH pad-to-pad hole clearance on different nets"
    (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Net != B.Net")
    (constraint hole_to_hole (min 0.50mm))
)

(rule "Pad-to-pad copper clearance"
    (condition "A.Type == 'Pad' && B.Type == 'Pad'")
    (constraint clearance (min 0.15mm))
)

(rule "NPTH-to-track clearance"
    (condition "A.Pad_Type == 'NPTH, mechanical' && B.Type == 'Track'")
    (constraint hole_clearance (min 0.254mm))
)

# Questo limite resta a 0,20 mm come raccomandato da PCBWay.
# Non viene inserita un'eccezione da 0,19 mm per J1: sarebbe soltanto
# un modo per nascondere una geometria nominalmente sotto il limite scelto.
(rule "NPTH with surrounding copper"
    (condition "A.Pad_Type == 'NPTH, mechanical' && B.Type != 'Track'")
    (constraint hole_clearance (min 0.20mm))
)

(rule "PTH pad-to-track clearance"
    (condition "A.isPlated() && A.Type != 'Via' && B.Type == 'Track'")
    (constraint clearance (min 0.20mm))
    (constraint hole_clearance (min 0.33mm))
)

# =========================================================
# BORDO SCHEDA E SERIGRAFIA
# =========================================================

(rule "Track-to-board-edge clearance"
    (condition "A.Type == 'Track'")
    (constraint edge_clearance (min 0.30mm))
)

(rule "Minimum silkscreen text"
    (layer "?.Silkscreen")
    (constraint text_thickness (min 0.15mm))
    (constraint text_height (min 0.80mm))
)

(rule "Pad-to-silkscreen clearance"
    (layer outer)
    (condition "A.Type == 'Pad' && (B.Type == 'Text' || B.Type == 'Graphic') && A.Reference != B.Reference")
    (constraint silk_clearance (min 0.15mm))
)

# =========================================================
# USB PRIMA DELLA PROTEZIONE ESD: J1 -> U4
# =========================================================

# Le reti USB_CONN sono ramificate per unire i contatti A/B reversibili
# del connettore USB-C. Sono ammesse piste su F.Cu e brevi ponti su B.Cu,
# con via passanti standard 0,60/0,30 mm.
(rule "USB connector-side track width"
    (condition "(A.NetName == '/USB_CONN_D+' || A.NetName == '/USB_CONN_D-') && A.Type == 'Track'")
    (constraint track_width (min 0.27mm) (opt 0.28mm) (max 0.29mm))
)

# =========================================================
# USB DOPO LA PROTEZIONE ESD: U4 -> U2
# =========================================================

# Il gap ha soltanto un valore ottimale: i brevi fan-out dai pad di U2 e U4
# hanno necessariamente gap maggiore. Il tratto parallelo controllato deve
# restare manualmente a 0,16 mm, con piste da 0,28 mm.
(rule "USB after ESD controlled routing"
    (condition "A.NetName == '/USB_D+' || A.NetName == '/USB_D-'")
    (constraint track_width (min 0.27mm) (opt 0.28mm) (max 0.29mm))
    (constraint diff_pair_gap (opt 0.16mm))
    (constraint skew (max 0.50mm) (within_diff_pairs))
    (constraint diff_pair_uncoupled (max 3.00mm))
    (constraint disallow via)
)

(rule "USB after ESD only on F.Cu"
    (condition "(A.NetName == '/USB_D+' || A.NetName == '/USB_D-') && A.Type == 'Track' && A.Layer != 'F.Cu'")
    (constraint disallow track)
)

# =========================================================
# PIANI INTERNI
# =========================================================

(rule "In1 reserved for continuous GND plane"
    (layer In1.Cu)
    (constraint disallow track)
)

# =========================================================
# ECCEZIONE PRODUTTIVA MIRATA PER IL CONNETTORE J1
# =========================================================

# I quattro fissaggi schermatura SH del footprint ufficiale GCT hanno
# anello nominale da 0,20 mm. PCBWay dichiara 0,15 mm come minimo:
# l'eccezione resta quindi producibile e non riduce il limite degli altri PTH.
# Le regole sono valutate dal basso verso l'alto, perciò questa regola
# specifica deve restare dopo la regola generale da 0,25 mm.
(rule "J1 shield stakes annular ring"
    (condition "A.Reference == 'J1' && A.Type == 'Pad' && A.isPlated()")
    (constraint annular_width (min 0.20mm))
)

# Eccezione per i due perni di posizionamento NPTH del connettore J1.
# Il land pattern ufficiale GCT/KiCad lascia 0,1944 mm verso i pad GND.
# L'eccezione vale esclusivamente tra elementi appartenenti allo stesso J1.
(rule "J1 locating pegs NPTH clearance"
    (condition "A.Reference == 'J1' && A.Pad_Type == 'NPTH, mechanical' && B.Reference == 'J1'")
    (constraint hole_clearance (min 0.19mm))
)
